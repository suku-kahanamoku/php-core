Options -Indexes
RewriteEngine On

# Block hidden paths except .well-known
RewriteRule (^|/)[.](?!well-known/) - [F,L]

# Disable temporary phpinfo endpoint
RewriteRule ^info[.]php - [F,L]

# Pass Authorization header to PHP (needed for Bearer token auth)
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Raw storage paths are never served by Apache. Files are downloaded through
# /api/files/content, where FileService applies tenant and visibility checks.
RewriteRule ^temp/ - [F,L]
RewriteRule ^files/ - [F,L]

# Allow direct access to existing files/dirs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything to index.php
RewriteRule ^ index.php [L,QSA]

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Block access to sensitive files
<FilesMatch "^\.env|composer\.(json|lock)|bootstrap\.php">
    Order allow,deny
    Deny from all
</FilesMatch>
