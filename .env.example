APP_ENV=development
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=php_core
DB_USER=php_core
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

ALLOWED_ORIGINS=http://zoo.localhost:3000,http://vinozezajeci.localhost:3000,https://zoo-crm.netlify.app,https://vinozezajeci.cz

# Backend host intentionally is not mapped to a tenant. Nuxt server proxies send
# the tenant frontend host in X-Forwarded-Host.
FRANCHISE_CODES=zoo.localhost:zoo,vinozezajeci.localhost:zajeci,zoo-crm.netlify.app:zoo,vinozezajeci.cz:zajeci

# Shared only with trusted server runtimes (never expose through public runtimeConfig).
INTERNAL_API_KEY=replace-with-at-least-32-random-bytes
ZAJECI_FRONTEND_URL=https://vinozezajeci.cz
ZOO_FRONTEND_URL=https://zoo-crm.netlify.app
