APP_ENV=development
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=php_core
DB_USER=php_core
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4

# Backend host intentionally is not mapped to a tenant. Nuxt server proxies send
# the tenant frontend host in X-Forwarded-Host.
FRANCHISE_CODES=etymolog.localhost:etymolog,sry.localhost:sry,api.sorry-jako.eu:sry,zoo.localhost:zoo,fann.localhost:fann,vinozezajeci.localhost:zajeci,zoo-crm.netlify.app:zoo,fann-crm.netlify.app:fann,vinozezajeci.cz:zajeci,collegas.netlify.app:collegas,collegas.cz:collegas,www.collegas.cz:collegas,prasentace.cz:prasentace,prasentace.netlify.app:prasentace,www.prasentace.cz:prasentace

# Shared only with trusted server runtimes (never expose through public runtimeConfig).
INTERNAL_API_KEY=replace-with-at-least-32-random-bytes

# Transactional mail. A tenant may override any value with a prefix derived
# from its franchise code, for example COLLEGAS_MAILER_SMTP_HOST.
MAILER_FROM=no-reply@example.com
MAILER_FROM_NAME=php-core
MAILER_SMTP_HOST=
MAILER_SMTP_USER=
MAILER_SMTP_PASS=
MAILER_SMTP_PORT=587
MAILER_SMTP_AUTH=true
MAILER_SMTP_SECURE=tls

# OpenAI key remains server-only. Rokid client key is a separate rotatable
# prototype credential and must never reuse INTERNAL_API_KEY.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_RECOMMENDATION_MODEL=gpt-5.6-terra
OPENAI_VECTOR_STORE_ENABLED=false
ROKID_AI_CLIENT_KEY=replace-with-at-least-32-random-bytes
ZAJECI_FRONTEND_URL=https://vinozezajeci.cz
ZOO_FRONTEND_URL=https://zoo-crm.netlify.app

# SRY: dedicated public API host must resolve to sry. Do not expose INTERNAL_API_KEY to the app.
SRY_FRONTEND_URL=https://app.sorry-jako.eu
SRY_CLOUDFLARE_URL=
SRY_CLOUDFLARE_SECRET=
# Enable Expo push access-token security in EAS; server token only.
SRY_EXPO_ACCESS_TOKEN=

# TRAM: private Java API gateway; server credentials only.
# Map the selected TRAM host to tram in FRANCHISE_CODES.
TRANSPORT_JAVA_ENABLED=0
TRANSPORT_JAVA_TENANT=tram
TRANSPORT_JAVA_URL=http://127.0.0.1:18095
TRANSPORT_JAVA_TOKEN=
TRANSPORT_LOCAL_PIPELINE_ENABLED=0
TRANSPORT_LOCAL_PIPELINE_TOKEN=

# Identify the Wikidata consumer with a real operator contact before enabling cron.
# ETYMOLOG_WIKIDATA_USER_AGENT=Etymolog/1.0 (https://your-domain.example/contact)

# Etymolog dispatch: process (default) starts CLI from web PHP.
# Set cron ONLY after configuring an external scheduler, every minute:
# php scripts/etymolog-sync.php --tenant=etymolog --queued-only
# This consumes button requests only; no request means no synchronization.
# ETYMOLOG_SYNC_DISPATCH=cron
# Cloudflare alternative: deploy cloudflare/etymolog and apply the HTTP-worker migration first.
# ETYMOLOG_SYNC_DISPATCH=cloudflare
# ETYMOLOG_SYNC_WORKER_URL=https://etymolog-sync.your-account.workers.dev/dispatch
# ETYMOLOG_SYNC_SECRET=replace-with-a-dedicated-random-secret-at-least-32-characters
