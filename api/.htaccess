Options -Indexes
DirectorySlash Off
RewriteEngine On

# Retired transport API: Astro communicates directly with Java.
RewriteRule ^transport(?:/|$) - [G,L]

# Pass Authorization header to PHP (needed for Bearer token auth)

RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Route known module prefixes to their own index.php (lazy loading)

RewriteRule ^(etymolog|transport-admin|sry|auth|roles|users|address|categories|products|customer-profiles|texts|enumerations|orders|invoices|mailer|templater|files|openai)(/.*)?$ $1/index.php [L,QSA]

# Everything else (root / and unknown paths) → index.php

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]
