{
    "name": "php-core/app",
    "description": "PHP microservice REST API with MySQL",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.1",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "guzzlehttp/guzzle": "^7.10",
        "ext-curl": "*",
        "workerman/workerman": "^5.1",
        "workerman/http-client": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Utils/sort.functions.php",
            "src/Utils/validator.functions.php",
            "src/Utils/filter.functions.php"
        ]
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "lint": "find api bin emails scripts src tests -type f -name '*.php' -print0 | xargs -0 -n 1 php -l && php -l bootstrap.php && php -l index.php && php -l info.php",
        "test:http": "bash scripts/test-http.sh",
        "test:etymolog": "bash scripts/test-etymolog.sh",
        "test:sry": "bash scripts/test-sry.sh",
        "test:java-gateway": "bash scripts/test-java-gateway.sh",
        "test:schema": "bash scripts/test-schema.sh",
        "test:files": "bash scripts/test-file-list.sh",
        "test": [
            "@test:http",
            "@test:etymolog",
            "@test:sry",
            "@test:java-gateway",
            "@test:schema",
            "@test:files"
        ]
    }
}
