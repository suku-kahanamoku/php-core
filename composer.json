{
    "name": "php-core/app",
    "description": "PHP microservice REST API with MySQL",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^7.1",
        "dompdf/dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "guzzlehttp/guzzle": "^7.10",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/Utils/sort.functions.php",
            "src/Utils/validator.functions.php",
            "src/Utils/filter.functions.php"
        ]
    },
    "scripts": {
        "migrate": "php bin/migrate.php"
    }
}
